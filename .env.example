# Copy to .env (repo root) and fill in what you use.

# ==========================================
# 1. LLM API (Groq) — Script & Caption Generation
# ==========================================
# Powers autonomous viral scripts and captions (qwen/qwen3.8-27b, openai/gpt-oss-120b)
GROQ_API_KEY="your_groq_api_key_here"
# Optional: specify primary Groq model (defaults to qwen/qwen3.8-27b)
GROQ_MODEL="qwen/qwen3.8-27b"

# ==========================================
# 2. Instagram Graph API (Meta for Developers)
# ==========================================
# Your Instagram Professional/Creator account user ID
# Meta App credentials from developers.facebook.com (used for token exchange & auto-refresh)
# 60-day Long-Lived Access Token (auto-refreshed weekly by token-manager.js)
IG_USER_ID="your_instagram_user_id"
IG_ACCESS_TOKEN="your_long_lived_token"
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"

# ==========================================
# 3. Automation & Schedule Settings
# ==========================================
# Videos are automatically stored in public/reels/ and served over HTTP.
# Account Warm-up Stage for new accounts:
# 1 = Weeks 1-2 (3 reels/week: Mon, Wed, Fri)
# 2 = Weeks 3-4 (7 reels/week)
# 3 = Weeks 5+ (Full schedule: 10 reels/week) [Default]
WARMUP_STAGE=3

# Optional: NewsAPI.org key for supplementary news trend scoring (free tier)
NEWS_API_KEY=""

# ==========================================
# 5. Faceless Shorts Factory & Media Tools (Optional)
# ==========================================
# ElevenLabs — required for TTS voice (tools/gen_voice.py) & sound effects (tools/gen_sfx.py)
ELEVENLABS_API_KEY=""

# Google Gemini — image generation (tools/gen_image.py)
GEMINI_API_KEY=""

# fal.ai — generative video clips (tools/gen_clip.py)
FAL_KEY=""